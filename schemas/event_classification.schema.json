{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event_classification.schema.json",
  "title": "EventClassification",
  "description": "Вывод LLM-классификатора для одного события. vLLM ограничивает генерацию этой схемой.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "instruments",
    "severity",
    "action_required",
    "action_type",
    "deadline",
    "summary",
    "rationale",
    "confidence"
  ],
  "properties": {
    "event_type": {
      "type": "string",
      "description": "Тип события",
      "enum": [
        "coupon_payment",
        "coupon_rate_change",
        "put_offer",
        "call_offer",
        "redemption",
        "amortization",
        "dividend",
        "reporting",
        "technical_default",
        "default",
        "restructuring",
        "issue_terms_change",
        "rating_change",
        "delisting",
        "corporate_action",
        "other"
      ]
    },
    "instruments": {
      "type": "array",
      "description": "Бумаги, которых касается событие",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["isin"],
        "properties": {
          "isin": { "type": "string", "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$" },
          "ticker": { "type": ["string", "null"] }
        }
      }
    },
    "severity": {
      "type": "string",
      "description": "Серьёзность для держателя бумаги",
      "enum": ["low", "medium", "high", "critical"]
    },
    "action_required": {
      "type": "boolean",
      "description": "Нужно ли держателю что-то сделать"
    },
    "action_type": {
      "type": ["string", "null"],
      "description": "Тип возможного действия, null если действие не нужно",
      "enum": ["submit_offer_order", "review_position", "set_stop", "watch", null]
    },
    "deadline": {
      "type": ["string", "null"],
      "description": "Крайний срок действия в формате YYYY-MM-DD, null если срока нет",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "summary": {
      "type": "string",
      "description": "Что произошло, одним-двумя предложениями простым языком",
      "maxLength": 400
    },
    "rationale": {
      "type": "string",
      "description": "Почему выбрана такая серьёзность, со ссылкой на факты из текста",
      "maxLength": 600
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
